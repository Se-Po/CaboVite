{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm ci)",
      "Bash(npx vite *)",
      "Bash(node --version)",
      "Bash(git diff *)",
      "Bash(git status *)",
      "WebFetch(domain:threejs.org)",
      "WebFetch(domain:monumentos.gov.pt)",
      "WebFetch(domain:cm-sesimbra.pt)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(npm install *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(npm publish *)",
      "Bash(npm run deploy *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/three-lint.mjs"]
          }
        ]
      }
    ]
  }
}
